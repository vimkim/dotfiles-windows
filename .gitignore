# Editor and operating-system leftovers.
*.bak
*.tmp
*~
.DS_Store
Thumbs.db
__pycache__/

# Only the Codex configuration belongs in source control; exclude runtime state.
dot_codex/*
!dot_codex/config.toml

# Runtime state must never become source configuration.
AppData/Roaming/zellij/config/*.lock
AppData/Roaming/zellij/config/*.heartbeat
AppData/Roaming/zellij/config/session-metadata/
AppData/Roaming/zellij/config/cache/
